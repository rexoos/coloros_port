<?xml version="1.0" encoding="UTF-8"?>
<filter-conf>
    <version>20220822</version>
    <toggle>1</toggle>
    <features>
        <feature name="OplusDEE" enable="1">
            <DC>enable</DC>
            <globalLTM>enable</globalLTM>
            <application name="com.coloros.video">
                <scene type="Application">
                    <action>
                        <mode>LTM</mode>
                    </action>
                </scene>
            </application>
            <application name="com.oplus.camera">
                <scene type="Application">
                    <action>
                        <mode>LTM</mode>
                    </action>
                </scene>
            </application>
            <application name="com.coloros.gallery3d">
                <scene type="Application">
                    <action>
                        <mode>LTM</mode>
                    </action>
                </scene>
            </application>
            <application name="com.oneplus.gallery">
                <scene type="Application">
                    <action>
                        <mode>LTM</mode>
                    </action>
                </scene>
            </application>
            <application name="com.heytap.yoli">
                <scene type="Application">
                    <action>
                        <mode>LTM</mode>
                    </action>
                </scene>
            </application>
        </feature>

        <feature name="curtain" enable="1">
            <application name="com.oneplus.gallery">
                <scene type="FuzzyLayer">
                    <layer>ViewGallery</layer>
                    <action>
                        <mode>SurfaceView</mode>
                    </action>
                </scene>
            </application>
            <application name="tv.danmaku.bili">
                <scene type="FuzzyLayer">
                    <layer>BangumiDetailActivityV3</layer>
                    <action>
                        <mode>SurfaceView</mode>
                    </action>
                </scene>
                <scene type="FuzzyLayer">
                    <layer>VideoDetailsActivity</layer>
                    <action>
                        <mode>SurfaceView</mode>
                    </action>
                </scene>
                <scene type="FuzzyLayer">
                    <layer>StoryVideoActivity</layer>
                    <action>
                        <mode>Normal</mode>
                    </action>
                </scene>
            </application>
            <application name="com.hunantv.imgo.activity">
                <scene type="FuzzyLayer">
                    <layer>ImmersivePlayActivity</layer>
                    <action>
                        <mode>Normal</mode>
                    </action>
                </scene>
                <scene type="FuzzyLayer">
                    <layer>VodPlayerPageActivity</layer>
                    <action>
                        <mode>Normal</mode>
                    </action>
                </scene>
                <scene type="FuzzyLayer">
                    <layer>DaMangPlayerActivity</layer>
                    <action>
                        <mode>Normal</mode>
                    </action>
                </scene>
            </application>
            <application name="com.tencent.qqlive">
                <scene type="FuzzyLayer">
                    <layer>VideoDetailActivity</layer>
                    <action>
                        <mode>SurfaceView</mode>
                    </action>
                </scene>
            </application>
            <application name="com.google.android.youtube">
                <scene type="FuzzyLayer">
                    <layer>SurfaceView[com.google.android.youtube/com.google.android.apps.youtube.app</layer>
                    <action>
                        <mode>SurfaceView</mode>
                    </action>
                </scene>
            </application>
            <application name="com.youku.phone">
                <scene type="FuzzyLayer">
                    <layer>DetailActivity</layer>
                    <action>
                        <mode>SurfaceView</mode>
                    </action>
                </scene>
            </application>
        </feature>

    </features>
</filter-conf>
